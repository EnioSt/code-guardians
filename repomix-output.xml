  /* Fundo azul profundo / noturno */
  --bg-primary: #070d18;
  --bg-card: #0e1726;
  --bg-card-hover: #162438;

  /* Textos quase brancos / acinzentados */
  --text-primary: #f1f5f9;
  --text-secondary: #94a3b8;

  /* Bordas e detalhes */
  --border-color: #1e293b;
  --accent-color: #38bdf8;
}

/* Aplicação global da fonte de código e transição suave de tema */
body {
  font-family: "JetBrains Mono", Consolas, Monaco, monospace;
  background-color: var(--bg-primary);
  color: var(--text-primary);
  transition:
    background-color 0.25s ease,
    color 0.25s ease;
  min-height: 100vh;
}
